# set parameters ======================
# geometry params
variable    dL	        equal 2e-4
variable    n_yz        equal 63
variable    n_ring      equal 200
variable    n_inlet     equal 3870
variable    r_si        equal 0.002
variable    r_catheter  equal ${r_si}
variable    r_catheter  equal 0.002
variable    r_torus     equal ${r_catheter}*2
variable    r_torus     equal 0.002*2
variable    l_pipe_vert equal 0.004
variable    l_pipe_hrz  equal 0.002
variable    l_si        equal 0.04-${dL}
variable    l_si        equal 0.04-0.0002
 # surface area of each wall particle
variable    A0          equal 2*PI*${r_si}*${l_si}/(${n_yz}*${n_ring})
variable    A0          equal 2*PI*0.002*${l_si}/(${n_yz}*${n_ring})
variable    A0          equal 2*PI*0.002*0.0398/(${n_yz}*${n_ring})
variable    A0          equal 2*PI*0.002*0.0398/(63*${n_ring})
variable    A0          equal 2*PI*0.002*0.0398/(63*200)
# simulation params
variable    cut	        equal 1.6*${dL}
variable    cut	        equal 1.6*0.0002
variable    skin        equal 0.3*${cut}
variable    skin        equal 0.3*0.00032
variable    c	        equal 5
variable    rho	        equal 993
variable    Ninflow     equal 10
# variable    Dt          equal 2e-5
# variable    mu          equal 1e-3 # dynamic viscosity
variable    zeta        equal 0.5  # artificial viscosity
variable    kB1         equal 0.25 # circumferential
variable    kB2         equal 0.5 # longitudinal
variable    theta_eq    equal 180*(${n_yz}-2)/${n_yz}
variable    theta_eq    equal 180*(63-2)/${n_yz}
variable    theta_eq    equal 180*(63-2)/63
variable    rc_solid    equal ${dL}*1.0
variable    rc_solid    equal 0.0002*1.0
variable    wall_damp   equal 1e-4
# variable    k_self      equal 6e-3

group       equipment   type 1
