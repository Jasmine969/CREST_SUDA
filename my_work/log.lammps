fix         out_depos fluid rheo/deposit 130000 0 10 623 region drop_mol_out near 0.0002             vx 0 0 vy 0 0 vz 0 0 rho ${rho} status 0 mol mymol orient 0 0 1             molfrac 0.13986014 0.13846154 0.13426573 0.12727273 0.11748252 0.1048951                     0.08951049 0.07132867 0.05034965 0.02657343
fix         out_depos fluid rheo/deposit 130000 0 10 623 region drop_mol_out near 0.0002             vx 0 0 vy 0 0 vz 0 0 rho 993 status 0 mol mymol orient 0 0 1             molfrac 0.13986014 0.13846154 0.13426573 0.12727273 0.11748252 0.1048951                     0.08951049 0.07132867 0.05034965 0.02657343
# outflow bc (evaporate)
fix         in_del fluid evaporate 100 10000 inlet_del 2332
fix         out_del fluid evaporate 100 10000 outlet_del 2332
# forces ==============================
# set pairs and bonds
pair_style  hybrid/overlay sph/rhosum/norm 2                            rheo ${cut} artificial/visc ${zeta}                            soft ${dL}                         #    rheo/solid
pair_style  hybrid/overlay sph/rhosum/norm 2                            rheo 0.00032 artificial/visc ${zeta}                            soft ${dL}                         
pair_style  hybrid/overlay sph/rhosum/norm 2                            rheo 0.00032 artificial/visc 0.5                            soft ${dL}                         
pair_style  hybrid/overlay sph/rhosum/norm 2                            rheo 0.00032 artificial/visc 0.5                            soft 0.0002                         
pair_coeff  * * rheo
# pair_coeff  1*2 2 rheo/solid ${kB2} ${rc_solid} ${wall_damp}
pair_coeff  3 3 sph/rhosum/norm ${cut}
pair_coeff  3 3 sph/rhosum/norm 0.00032
pair_coeff  1*2 3 soft ${soft}
pair_coeff  1*2 3 soft 6e-10

special_bonds      lj 0 1 1 coul 0 1 1
bond_style         bpm/spring break no smooth no
Resetting peratom fix info from restart file:
  fix style: property/atom, fix ID: HISTORY_BPM_SPRING_FIX_PROP_ATOM
Resetting global fix info from restart file:
  fix style: BOND_HISTORY, fix ID: HISTORY_BPM_SPRING
bond_coeff         1 ${kB1} 1.0 ${wall_damp}
bond_coeff         1 0.25 1.0 ${wall_damp}
bond_coeff         1 0.25 1.0 0.0001
bond_coeff         2 ${kB2} 1.0 ${wall_damp}
bond_coeff         2 0.5 1.0 ${wall_damp}
bond_coeff         2 0.5 1.0 0.0001

angle_style harmonic/concave
angle_coeff 1 ${kA} ${theta_eq} x ${n_yz}
angle_coeff 1 1.6e-08 ${theta_eq} x ${n_yz}
angle_coeff 1 1.6e-08 174.285714285714 x ${n_yz}
angle_coeff 1 1.6e-08 174.285714285714 x 63

fix     rheo all rheo ${cut} quintic 0 density ${rho} ${rho} ${rho} speed/sound $c $c $c         fixed/vel 1 0 0
fix     rheo all rheo 0.00032 quintic 0 density ${rho} ${rho} ${rho} speed/sound $c $c $c         fixed/vel 1 0 0
fix     rheo all rheo 0.00032 quintic 0 density 993 ${rho} ${rho} speed/sound $c $c $c         fixed/vel 1 0 0
fix     rheo all rheo 0.00032 quintic 0 density 993 993 ${rho} speed/sound $c $c $c         fixed/vel 1 0 0
fix     rheo all rheo 0.00032 quintic 0 density 993 993 993 speed/sound $c $c $c         fixed/vel 1 0 0
fix     rheo all rheo 0.00032 quintic 0 density 993 993 993 speed/sound 5 $c $c         fixed/vel 1 0 0
fix     rheo all rheo 0.00032 quintic 0 density 993 993 993 speed/sound 5 5 $c         fixed/vel 1 0 0
fix     rheo all rheo 0.00032 quintic 0 density 993 993 993 speed/sound 5 5 5         fixed/vel 1 0 0
        # fixed/rho/region fixedrho
# fix     visc all rheo/viscosity * constant ${mu}
fix     press all rheo/pressure * tait/water
# set the force of fluid
fix     G_fluid fluid gravity -9.81 vector 0 0 1
fix     G_wall wall gravity -9.81 vector 0 0 1
# self-spring
fix     y0 wall store/state 0 y
Resetting peratom fix info from restart file:
  fix style: store/state, fix ID: y0
fix     z0 wall store/state 0 z
Resetting peratom fix info from restart file:
  fix style: store/state, fix ID: z0
# nonlinear restoring force
variable  Dy atom (f_y0-y)*gmask(wall)
variable  Dz atom (f_z0-z)*gmask(wall)
variable  FRy atom (2*(v_Dy>0)-1)*((abs(v_Dy)*${k1_self}+abs(v_Dy)^2*${k2_self}))
variable  FRy atom (2*(v_Dy>0)-1)*((abs(v_Dy)*0+abs(v_Dy)^2*${k2_self}))
variable  FRy atom (2*(v_Dy>0)-1)*((abs(v_Dy)*0+abs(v_Dy)^2*18))
variable  FRz atom (2*(v_Dz>0)-1)*((abs(v_Dz)*${k1_self}+abs(v_Dz)^2*${k2_self}))
variable  FRz atom (2*(v_Dz>0)-1)*((abs(v_Dz)*0+abs(v_Dz)^2*${k2_self}))
variable  FRz atom (2*(v_Dz>0)-1)*((abs(v_Dz)*0+abs(v_Dz)^2*18))
fix       FR wall addforce 0 v_FRy v_FRz
# bath
variable  ringID atom ceil((id-v_n_inlet)/v_n_yz)
compute   ringID wall chunk/atom v_ringID nchunk once ids once
compute   yz wall property/atom y z
fix       yzAvg wall ave/chunk/preforce 1 1 1 ringID c_yz[1] c_yz[2]
compute   yzAvg wall chunk/spread/atom ringID f_yzAvg[2] f_yzAvg[3]
variable  y_yc  atom y-c_yzAvg[1]
variable  z_zc  atom z-c_yzAvg[2]
variable  rc    atom sqrt(v_y_yc^2+v_z_zc^2)
variable  Fbath atom ${A0}*${rho}*9.81*(${r_torus}-z)*gmask(wall)
variable  Fbath atom 3.96937738453568e-08*${rho}*9.81*(${r_torus}-z)*gmask(wall)
variable  Fbath atom 3.96937738453568e-08*993*9.81*(${r_torus}-z)*gmask(wall)
variable  Fbath atom 3.96937738453568e-08*993*9.81*(0.004-z)*gmask(wall)
variable  Fy_bath atom -v_Fbath*v_y_yc/(v_rc+1e-30)
variable  Fz_bath atom -v_Fbath*v_z_zc/(v_rc+1e-30)
fix       F_bath wall addforce 0 v_Fy_bath v_Fz_bath
# zero xforce of wall
fix       xforce0  wall setforce 0. NULL NULL
# fix the pressure of the vert pipe and torus
# variable  p0 atom ${rho}*9.81*(${r_torus}+${l_pipe_vert}*0.9-z)
# variable  rho0 atom (7*v_p0/($c^2*${rho})+1)^(1/7)*${rho}
# fix       fixedrho fluid setrho v_rho0 region fixedrho
# active force
fix       F_active wall external pf/callback ${Ncallback} 1
fix       F_active wall external pf/callback 50 1
# balance ========================
comm_style tiled
fix       bl all balance 10000 1.01 rcb
# Diagnostics ====================
# density and pressure
compute     rho all rheo/property/atom rho
compute     p all rheo/property/atom pressure
compute     rhomin fluid reduce/region updaterho min c_rho
compute     rhomax fluid reduce/region updaterho max c_rho
compute     fsph all rheo/property/atom fsph/y fsph/z
compute     fbond all rheo/property/atom fbpm/y fbpm/z
compute     visc all rheo/property/atom viscosity

# inflow and outflow rates
variable    n_inflow    equal f_in_del+count(fluid,inlet)-f_in_depos
variable    n_outflow   equal f_out_del+count(fluid,outlet)-f_out_depos

# wall strain
variable    strain atom (v_rc-v_r_si)/v_r_si*gmask(wall)
fix         strainAvg wall ave/chunk/preforce 1 ${Ncallback} ${Ncallback} ringID v_strain
fix         strainAvg wall ave/chunk/preforce 1 50 ${Ncallback} ringID v_strain
fix         strainAvg wall ave/chunk/preforce 1 50 50 ringID v_strain
compute     strainAvg wall chunk/spread/atom ringID f_strainAvg[2]
compute     strainMin wall reduce  min c_strainAvg
compute     strainMax wall reduce  max c_strainAvg
# output =================================
# global output
thermo	      20
thermo_style	custom step time press atoms c_rhomin c_rhomax f_in_del f_out_del f_in_depos f_out_depos
thermo_modify	norm no

# dump per-atom output (moved to neuron_fluid_get_dump.py)

# dump	my_dump all custom ${dmp_interval} #         ${case_path}/${go_on_from_step}to${end_step}.dump #         id type x y z vx vy vz fx fy fz mass c_p c_rho c_strainAvg c_ringID #         v_Fy_bath v_Fz_bath v_FRy v_FRz f_F_active[2] f_F_active[3] c_fsph[1] c_fsph[2]
# dump_modify my_dump format float %.6e

# RUN ==========================
timestep    ${Dt}
timestep    2e-05
neighbor    ${skin} bin
neighbor    9.6e-05 bin
restart     ${N_restart} ${case_path}/restart/*.restart
restart     50000 ${case_path}/restart/*.restart
restart     50000 results/demo/restart/*.restart
log         ${case_path}/log_${go_on_from_step}to${end_step}.lammps
log         results/demo/log_${go_on_from_step}to${end_step}.lammps
log         results/demo/log_0to${end_step}.lammps
log         results/demo/log_0to1250000.lammps
